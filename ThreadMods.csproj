<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <Optimize>true</Optimize>
    <ExileApiDirectory>$(exapiPackage)</ExileApiDirectory>
    <ExileApiDirectory Condition="!Exists('$(ExileApiDirectory)\ExileCore.dll')">$(MSBuildProjectDirectory)\..\..\..</ExileApiDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ExileCore" HintPath="$(ExileApiDirectory)\ExileCore.dll" Private="false" />
    <Reference Include="GameOffsets" HintPath="$(ExileApiDirectory)\GameOffsets.dll" Private="false" />
    <Reference Include="Hexa.NET.ImGui" HintPath="$(ExileApiDirectory)\Hexa.NET.ImGui.dll" Private="false" />
    <Reference Include="SharpDX.Mathematics" HintPath="$(ExileApiDirectory)\SharpDX.Mathematics.dll" Private="false" />
  </ItemGroup>
</Project>
